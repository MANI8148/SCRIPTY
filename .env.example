# SCRIPTY Story Generation System - Environment Configuration

# Redis Configuration
# Redis connection URL for distributed caching
# Format: redis://[username:password@]host:port/database
# Example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Cache Configuration
# Time-to-live for cached data in hours (default: 24)
CACHE_TTL_HOURS=24

# API Configuration
# Timeout for external API calls in seconds (default: 3)
API_TIMEOUT_SECONDS=3

# Entity Validation
# Enable strict entity validation (true/false, default: true)
ENTITY_VALIDATION_STRICT=true

# Server Configuration
# Port for Flask/FastAPI server (default: 5000)
PORT=5000

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO
