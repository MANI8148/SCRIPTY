digraph SCRIPTY {
  rankdir=LR;
  node [shape=box, style=rounded];

  UI [label="Vanilla Frontend"];
  API [label="Flask API"];
  Engine [label="StoryEngine"];
  Metrics [label="PerformanceMonitor"];
  Jobs [label="BookJobQueue"];
