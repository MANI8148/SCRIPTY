  Research [label="Research Roadmap"];
  Retrieval [label="Future Retrieval Layer"];

  UI -> API;
  API -> Engine;
  API -> Metrics;
  API -> Jobs;
  API -> Cache;
  Engine -> Location;
  Engine -> Dataset;
  Engine -> Chapter;
